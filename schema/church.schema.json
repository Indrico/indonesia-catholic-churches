{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indonesia-catholic-churches:church:1.0.0",
  "title": "Indonesian Catholic worship site",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "diocese", "administrative_area", "address", "contact", "location", "parent_parish_id", "mass_schedules", "sources", "field_provenance", "conflicts", "verification"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["katedral", "paroki", "stasi", "kapel"] },
    "diocese": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/text" } }
    },
    "administrative_area": {
      "type": "object", "additionalProperties": false,
      "required": ["country", "province", "city", "district", "subdistrict", "postal_code"],
      "properties": {
        "country": { "const": "ID" },
        "province": { "$ref": "#/$defs/text" },
        "city": { "$ref": "#/$defs/text" },
        "district": { "$ref": "#/$defs/text" },
        "subdistrict": { "$ref": "#/$defs/text" },
        "postal_code": { "type": ["string", "null"], "pattern": "^[0-9]{5}$" }
      }
    },
    "address": { "$ref": "#/$defs/text" },
    "contact": {
      "type": "object", "additionalProperties": false,
      "required": ["phone", "phone_e164", "email", "website"],
      "properties": {
        "phone": { "$ref": "#/$defs/text" },
        "phone_e164": { "type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{1,14}$" },
        "email": { "type": ["string", "null"], "format": "email" },
        "website": { "$ref": "#/$defs/url" }
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["latitude", "longitude", "coordinate_source"],
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "coordinate_source": { "$ref": "#/$defs/url" },
        "google_maps_url": { "$ref": "#/$defs/url" }
      }
    },
    "parent_parish_id": { "type": ["string", "null"], "format": "uuid" },
    "mass_schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "field_provenance": {
      "type": "object", "propertyNames": { "pattern": "^/" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } }
    },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "verified_at", "reviewed_by", "evidence"],
      "properties": {
        "status": { "enum": ["unverified", "source_verified", "needs_review"] },
        "verified_at": { "type": ["string", "null"], "format": "date" },
        "reviewed_by": { "$ref": "#/$defs/text" },
        "evidence": { "type": "array", "items": { "type": "string", "format": "uri", "pattern": "^https?://" } }
      }
    }
  },
  "$defs": {
    "text": { "type": ["string", "null"], "minLength": 1 },
    "url": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://" },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_text", "day", "time", "time_zone", "notes"],
      "properties": {
        "raw_text": { "type": "string", "minLength": 1 },
        "day": { "enum": [null, "senin", "selasa", "rabu", "kamis", "jumat", "sabtu", "minggu"] },
        "time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "time_zone": { "enum": [null, "Asia/Jakarta", "Asia/Makassar", "Asia/Jayapura"] },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "name", "url", "accessed_at", "license", "terms_sha256", "content_sha256", "extractor_version"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "identity_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "accessed_at": { "type": "string", "format": "date" },
        "license": { "type": "string", "minLength": 1 },
        "terms_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "extractor_version": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["source_index", "value", "locator", "observed_at", "method"],
      "properties": {
        "source_index": { "type": "integer", "minimum": 0 },
        "value": {},
        "locator": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "observed_at": { "type": "string", "format": "date" },
        "method": { "type": "string", "minLength": 1 }
      }
    }
  }
}
